# Mẫu cấu hình của backend. Chép thành backend/.env: file đó nằm trong .gitignore và KHÔNG BAO GIỜ được commit.
# Lệnh dưới đây (chạy trong thư mục backend/) tạo backend/.env với JWT_SECRET ngẫu nhiên 32 byte ghi thẳng vào file,
# không bao giờ in khóa ra màn hình, và từ chối ghi đè nếu .env đã tồn tại (báo lỗi EEXIST):
# node -e "const fs=require('fs'),c=require('crypto');const t=fs.readFileSync('.env.example','utf8').replace(/^JWT_SECRET=.*/m,'JWT_SECRET='+c.randomBytes(32).toString('hex'));fs.writeFileSync('.env',t,{flag:'wx'})"
# npm run start, start:test, seed và reset đều đọc backend/.env. Biến đã đặt sẵn trong shell được ưu tiên hơn file này
# (start:test chỉ ép riêng NODE_ENV=test).
# Cổng HTTP của API (mặc định 5000)
PORT=5000
# MongoDB của dự án chạy trong Docker ở cổng 27018 (27017 là dịch vụ MongoDB của Windows, không dùng)
MONGODB_URI=mongodb://127.0.0.1:27018/flashsale
# Redis trong Docker, db 0 là dữ liệu demo
REDIS_URL=redis://127.0.0.1:6379
# Địa chỉ frontend được phép gọi API (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Bắt buộc, không có giá trị mặc định. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Kích thước pool kết nối MongoDB, đặt tường minh để ghi lại khi đo tải
MONGO_MAX_POOL_SIZE=100

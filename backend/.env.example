# Cổng HTTP của API (mặc định 5000)
PORT=5000
# MongoDB của dự án chạy trong Docker ở cổng 27018 (27017 là dịch vụ MongoDB của Windows, không dùng)
MONGODB_URI=mongodb://127.0.0.1:27018/flashsale
# Redis trong Docker, db 0 là dữ liệu demo
REDIS_URL=redis://127.0.0.1:6379
# Địa chỉ frontend được phép gọi API (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Bắt buộc, không có giá trị mặc định. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Kích thước pool kết nối MongoDB, đặt tường minh để ghi lại khi đo tải
MONGO_MAX_POOL_SIZE=100
